{
  "name": "map",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "build": "bun run --cwd apps/dashboard build",
    "clean": "git clean -xdf node_modules",
    "dev": "bun run --cwd apps/dashboard dev",
    "start": "bun run --cwd apps/dashboard start",
    "format": "biome format --write .",
    "lint": "bun run --cwd apps/dashboard lint",
    "typecheck": "bun run --cwd apps/dashboard typecheck"
  },
  "dependencies": {
    "@biomejs/biome": "2.3.10",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.1.16",
  "resolutions": {
    "jackspeak": "2.1.1"
  }
}
