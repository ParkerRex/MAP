{
  "name": "map",
  "private": true,
  "workspaces": ["packages/*", "apps/*", "packages/email/*"],
  "scripts": {
    "build": "turbo build",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo clean",
    "dev": "turbo dev --parallel",
    "test": "turbo test --parallel",
    "start:dashboard": "turbo start --filter=@map/dashboard",
    "start:website": "turbo start --filter=@map/website",
    "dev:api": "turbo dev --filter=@map/api",
    "dev:dashboard": "turbo dev --filter=@map/dashboard",
    "build:dashboard": "turbo build --filter=@map/dashboard",
    "dev:engine": "turbo dev --filter=@map/engine",
    "dev:website": "turbo dev --filter=@map/website ",
    "dev:desktop": "turbo dev --filter=@map/desktop",
    "jobs:dashboard": "turbo jobs --filter=@map/dashboard",
    "format": "biome format --write .",
    "lint": "turbo lint && manypkg check",
    "typecheck": "turbo typecheck"
  },
  "dependencies": {
    "@biomejs/biome": "1.8.3",
    "@manypkg/cli": "^0.21.4",
    "turbo": "2.0.9",
    "typescript": "^5.5.4"
  },
  "packageManager": "bun@1.1.16",
  "resolutions": {
    "jackspeak": "2.1.1"
  }
}
